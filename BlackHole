	public void spawnRay(int newx, int newy, int newz) {
		for(int i = 0; i < rays.size(); i++) {
			int index = (lastSpawnIndex + i) % rays.size();
			Ray r = rays.get(index);
			if(!r.isAlive) {
				lastSpawnIndex = index;
				r.z = newz;
				r.x = newx;
				r.y = newy;
				r.r = Math.sqrt(r.x * r.x + r.y * r.y + r.z * r.z);
				r.phi = Math.atan2(r.y, r.x);
				r.dr = (r.x * 10000 + r.y * 0) / r.r;
				r.dphi = (r.x * 0 - r.y * 10000) / (r.r * r.r);
				r.isAlive = true;
				return;
			}
		}
		rays.add(new Ray(newx, newy, newz));
	}
	
	public double dphi2(double r,double dr, double dphi, double theta, double dtheta) {
		return -2 / r * dr * dphi - 2 * (Math.cos(theta) / Math.sin(theta)) * dphi * dtheta;
	}
	
	public double dr2(double r, double dr, double phi, double dphi, double theta, double dtheta) {
		//return -(r_s / (2 * r * r)) * (E * E) + (r_s)/(2 * r * r * (1 - r_s/r)) * (dr * dr) + (r - r_s)*(dphi * dphi);
		//return r_s/(2 * r * (r - r_s))*(dr*dr) + (r - 1.5 * r_s) * ((dtheta * dtheta) + Math.sin(theta) * Math.sin(theta) * (dphi * dphi));
		double M = (G * m) / (c * c);
		return -M / (r * r) * dr * dr + (r - 3 * M)*(dtheta * dtheta + (Math.sin(theta) * Math.sin(theta)) * dphi * dphi);
	}
	
	public double dtheta2(double r, double dr, double dphi, double theta, double dtheta) {
		return -2 / r * dr * dtheta + Math.sin(theta) * Math.cos(theta) * (dphi * dphi);
	}
	
	public void step() {
		isStepping = true;
		beta = sli.beta;
		for(int i = rays.size() - 1; i >= 0; i--) {
			Ray r = rays.get(i);
			if(r.isAlive && r.r > 1.2* r_s ){//&& r.x < 8000 && r.x > -800 && r.y < 8000 && r.y > -600
				double t = 0.0005;
				double rho = r.r;
				double phi = r.phi;
				double dr = r.dr;
				double dphi = r.dphi;
				double theta = r.theta;
				double dtheta = r.dtheta;
				t *= (1 - r_s / r.r);
				
				
				double k1r = dr;
				double k1dr = dr2(rho, dr, phi, dphi, theta, dtheta);
				double k1phi = dphi;
				double k1dphi = dphi2(rho, dr, dphi, theta, dtheta);
				double k1theta = dtheta;
				double k1dtheta = dtheta2(rho, dr, dphi, theta, dtheta);
				
				double k2r = dr + t * .5 * k1r;
				double k2dr = dr2(rho + t * .5 * k1r, dr + t * .5 * k1dr, phi + t * .5 * k1phi, dphi + t * .5 * k1dphi, theta + t * .5 * k1theta, dtheta + t * .5 * k1dtheta);
				double k2phi = dphi + t * .5 * k1phi;
				double k2dphi = dphi2(rho + t * .5 * k1r, dr + t * .5 * k1dr, dphi + t * .5 * k1dphi, theta + t * .5 * k1theta, dtheta +t * .5 * k1dtheta);
				double k2theta = dtheta + t * .5 * k1theta;
				double k2dtheta = dtheta2(rho + t * .5 * k1r, dr + t * .5 * k1dr, dphi + t * .5 * k1dphi, theta + t * .5 * k1theta, dtheta +t * .5 * k1dtheta);
				
				double k3r = dr + t * .5 * k2r;
				double k3dr = dr2(rho + t * .5 * k2r, dr + t * .5 * k2dr, phi + t * .5 * k2phi, dphi + t * .5 * k2dphi, theta + t * .5 * k2theta, dtheta +t * .5 * k2dtheta);
				double k3phi = dphi + t * .5 * k2phi;
				double k3dphi = dphi2(rho + t * .5 * k2r, dr + t * .5 * k2dr, dphi + t * .5 * k2dphi, theta + t * .5 * k2theta, dtheta +t * .5 * k2dtheta);
				double k3theta = dtheta + t * .5 * k2theta;
				double k3dtheta = dtheta2(rho + t * .5 * k2r, dr + t * .5 * k2dr, dphi + t * .5 * k2dphi, theta + t * .5 * k2theta, dtheta +t * .5 * k2dtheta);
				
				double k4r = dr + t* k3r;
				double k4dr = dr2(rho + t * k3r, dr + t * k3dr, phi + t * k3phi, dphi + t * k3dphi, theta + t  * k3theta, dtheta +t* k3dtheta);
				double k4phi = dphi + t * k3phi;
				double k4dphi = dphi2(rho + t * k3r, dr + t * k3dr, dphi + t * k3dphi, theta + t * k3theta, dtheta +t * k3dtheta);
				double k4theta = dtheta + t * k3theta;
				double k4dtheta = dtheta2(rho + t * k3r, dr + t * k3dr, dphi + t * k3dphi, theta + t * k3theta, dtheta +t * k3dtheta);
				
				rho = rho + (t / 6)*(k1r + 2 * k2r + 2 * k3r + k4r);
				dr = dr + (t / 6) * (k1dr + 2 * k2dr + 2 * k3dr + k4dr);
				phi = phi + (t / 6) * (k1phi + 2 * k2phi + k3phi + k4phi);
				dphi = dphi + (t / 6) * (k1dphi + 2 * k2dphi + 2 * k3dphi + k4dphi);
				theta = theta + (t / 6) * (k1theta + 2 * k2theta + 2 * k3theta + k4theta);
				dtheta = dtheta + (t / 6) * (k1dtheta + 2 * k2dtheta + 2 * k3dtheta + k4dtheta);
				
				r.r = rho;
				r.dr = dr;
				r.phi = phi;
				r.dphi = dphi;
				r.theta = theta;
				r.dtheta = dtheta;
				r.x = (int)Math.round(rho * Math.sin(theta) * Math.cos(phi));
				r.y = (int)Math.round(rho * Math.sin(theta) * Math.sin(phi));// / Math.cos(3 * pi / 2 + 1)
				r.z = (int)Math.round(rho * Math.cos(theta));
				
				
				/*
				 * Time for some RK4
				 */
			}
			else {
				r.color = Color.BLACK;
				r.isAlive = false;
				continue;
				//rays.remove(r);
			}
		}
		this.repaint();
		for(int i = rays.size() - 1; i >= 0; i--) {
			if(rays.get(i).x > 100) {
				rays.remove(i);
			}
		
		}
		isStepping = false;
	}
	
	
