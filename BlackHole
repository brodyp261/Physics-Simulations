class Ray extends JPanel{
	public int x;
	public int y, z;
	public double r;
	public double phi, theta;
	public double dr;
	public double dphi, dtheta;
	public volatile boolean isAlive;
	public Color color;
	
	public Ray(int xx, int yy, int zz) {
		z = zz;
		x = xx;
		y = yy;
		r = Math.sqrt(xx * xx + yy * yy + zz * zz);
		phi = Math.atan2(yy, xx);
		theta = Math.acos(z / r);
		dr = (x * 10000 + y * 0) / r;
		dphi = (- y * 10000) / (x*x + y*y);//(x * 0 - y * 10000) / (r * r) or -(y * 10000) / (x * x + y * y) or (y * 10000) / ((r * r) * (Math.sin(theta) * Math.sin(theta)))
		dtheta = ((x * 10000) * z ) / (r * r * Math.hypot(x,y));//((x * 10000) * z) / (r * r * Math.hypot(x,y)) or (-z * dr) / ((r * r) * (Math.sin(theta) * Math.sin(theta)))
		isAlive = true;
		color = Color.yellow;
	}
}


class BlackHoleSliders extends JPanel implements ChangeListener{
