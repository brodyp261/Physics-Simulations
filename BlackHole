	public BlackHoleSliders(int initialA, int initialB) {
		alphal = new JLabel("β = " + initialA + "\u00B0");
		alphal.setForeground(Color.WHITE);
		alphal.setBounds(0, 600, 200, 100);
		this.add(alphal);
		
		betal = new JLabel("β = " + initialB + "\u00B0");
		betal.setForeground(Color.WHITE);
		betal.setBounds(0, 600, 200, 100);
		betas = new JSlider(0, 179, initialB);
		betas.setBackground(Color.BLACK);
		betas.setForeground(Color.WHITE);
		betas.addChangeListener(this);
		betas.setMajorTickSpacing(90);
		betas.setPaintTicks(true);
		betas.setPaintLabels(true);
		betas.addChangeListener(this);
		
		alphas = new JSlider(0, 360, initialA);
		alphas.setBackground(Color.BLACK);
		alphas.setForeground(Color.WHITE);
		alphas.addChangeListener(this);
		alphas.setMajorTickSpacing(90);
		alphas.setPaintTicks(true);
		alphas.setPaintLabels(true);
		alphas.addChangeListener(this);
		alpha = Math.toRadians(initialA);
		beta = Math.toRadians(initialB);
		alphas.setBounds(0,300,250,300);
		this.setBackground(Color.BLACK);
		this.add(alphas);
		JLabel space = new JLabel(" ");
		space.setBackground(Color.BLACK);
		this.add(space);
		//this.add(betas);

		//this.add(betal);
	}
	@Override
	public void stateChanged(ChangeEvent e) {
		alpha = Math.toRadians(alphas.getValue());
		alphal.setText("β = " + alphas.getValue() + "\u00B0");
		beta = Math.toRadians(betas.getValue());
		betal.setText("β = " + betas.getValue() + "\u00B0");
	}
