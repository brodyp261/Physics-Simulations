	public ArrayList<Point3d> getPoints(double[][][] relProbs){
		ArrayList<Point3d> points = new ArrayList<Point3d>(10000);
		double alphasin = Math.sin(paint3d.alpha);
		double alphacos = Math.cos(paint3d.alpha);
		double anglecos = Math.cos(paint3d.angle);
		double anglesin = Math.sin(paint3d.angle);
		
		
		for(int x = -245; x <= 245; x+= 2) {
				int xp = (x + 245) / 2;
				
				
				for(int y = -245; y <= 245; y+= 2) {
					int yp = (y + 245) / 2;
					for(int z = -245; z <= 245; z+= 2) {
					
						int zp = (z + 245) / 2;
						double rel = relProbs[xp][yp][zp];
						if(rel > 0.0004) {
							double x1 = x;
							double y1 = y * alphacos - z * alphasin;
							double z1 = y * alphasin + z * alphacos;
								
						
							double xprime = (x1 * anglecos + z1 * anglesin);
							double yprime =y1;
							double zprime = (-x1 * anglesin + z1 * anglecos);
					
							double scale = 300.0 / (zprime + 500.0);
							xprime *= scale;
							
							yprime *= -scale;
						
							points.add(new Point3d(xprime, yprime, zprime, getColor(rel)));
					}
					
				}
			}  
						}
			

		Collections.sort(points, Comparator.comparingDouble(Point3d::getZ));
		return points;
	}
	
