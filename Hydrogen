	//Math:
		 public long factorial(int n){
	    if(n == 0){
	      return 1;
	    }
	    long result = 1;
	    for(int i = 1; i <= n; i++){
	      result *= i;
	    }
	    return result;
	  }
	  
	  public long doubleFactorial(int n){ //not perfect but gets the job done
	    long result = 1;
	    for(int i = 1; i <= n; i += 2){
	      result *= i;
	    }
	    return result;
	  }
	  
	  
	  public double Laguerre(double alpha, double nu, double rho){ //AI WITH THE ASSIST
	    if(nu == 0)
	      return 1;
	    if(nu == 1)
	      return 1 + alpha - rho;
	    return ((2 * nu - 1 + alpha - rho) * Laguerre(alpha, nu - 1, rho) - (nu - 1 + alpha) * Laguerre(alpha, nu - 2, rho))/nu;
	  }
	  
	  public double Radial(double n, double l, double r){
	    double rho = (2*r)/(n*a0);
	    double alpha = 2 * l + 1;
	    double nu = n - l - 1;
	    return Math.sqrt(Math.pow((2/(n * a0)), 3) * (factorial((int)nu))/(2 * n * factorial((int)n + (int)l))) * Math.pow(e, -1 * rho/2) * Math.pow(rho, l) * Laguerre(alpha, nu, rho);
	  }
	  
	  public double legendre(double l, double x){
	    if (l == 0)
	      return 1;
	    if (l == 1)
	      return x;
	    return (((2 * l - 1)/l) * x * legendre(l - 1, x) - ((l - 1)/l) * legendre(l - 2, x));
	  }
	  
	  public double AssLegendre(double l, double m, double x){
		  if (m < 0) {
			  return Math.pow(-1,  Math.abs(m)) * doubleFactorial((int)l - (int)Math.abs(m))/ doubleFactorial((int)l + (int)Math.abs(m)) * AssLegendre(l, Math.abs(m), x);
		  }
	    if(m == 0){
	      return legendre(l, x);
	    }
	    if(m == l){
	      
	      return Math.pow(-1, m) * doubleFactorial(2 * (int)m - 1) * Math.pow(1 - (x * x), m / 2);}
	    if(m + 1 == l){
	      return x * (2 * m + 1) * AssLegendre(m , m, x);}
	    
	    return (x * (2 * l - 1) * AssLegendre(l - 1, m, x) - (l + m - 1) * AssLegendre(l - 2, m, x)) / (l - m);
	  }
	  
	  public double Angular(double l, double m, double theta, double phi){
	    double x =  Math.cos(theta);
	    double newm = Math.abs(m); //might delete later, but apparently this is correct, the m must be abs
	    return Math.abs(Math.pow(-1, (newm + m)/2) * Math.sqrt(((2 * l + 1) / (4 * pi)) * ((double)factorial((int)l - (int)newm)/factorial((int)l + (int) newm))) * AssLegendre(l, m, x) * Math.pow(e, 0 * newm * phi)); //This also includes i, but i chose not to add it
	  }
	  
	  public double psi(int n, double l, double m, double r, double theta, double phi){
	    
	    return Math.abs(Radial(n, l, r)) * Angular(l, m, theta, phi);
	  }
	  
	  
	  

