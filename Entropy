	public void step() {
		double newk =   k;
		isStepping = true;
		Random hi = new Random();
		boolean betterEntropy = false;
		for(EntropyPanel p : panels) {
			p.repaint();
		}
		while(!betterEntropy) {
			
			int randIndex = hi.nextInt(225);
			EntropyPanel randTest = panels.get(randIndex);
			while(randTest.particles <= 0) {
				randIndex = hi.nextInt(225);
				randTest = panels.get(randIndex);
			}
			int[] possibleIndexes = {-1, -1, -1, -1};
			if(randIndex - numBoxes >= 0) {
				possibleIndexes[0] = randIndex - numBoxes;
			}
			if((randIndex - 1) > 0 && (randIndex - 1) % numBoxes != (numBoxes - 1)) {
				possibleIndexes[1] = randIndex - 1;
			}
			if((randIndex + numBoxes) < 225) {
				possibleIndexes[2] = randIndex + numBoxes;
			}
			if((randIndex + 1) < 225 && (randIndex + 1) % numBoxes != 0) {
				possibleIndexes[3] = randIndex + 1;
			}
			int randIndex2 = hi.nextInt(4);
			while(possibleIndexes[randIndex2] == -1) {
				randIndex2 = hi.nextInt(4);
			}
			randTest.particles --;
			panels.get(possibleIndexes[randIndex2]).particles ++;
			Logomega = setOmega(panels);
			double tempS = setS(Logomega);
			double deltaS = tempS - S;
			
			if(deltaS >= 0) { //Originally had a hard cutoff of -1E0-5 * k, but switched it to metropolis probability for smoother sims
				betterEntropy = true;
				S = tempS;
			}
			else if (Math.random() < Math.exp(deltaS / newk)){
				betterEntropy = true;
				S = tempS;
			}
			else {
				panels.get(possibleIndexes[randIndex2]).particles--;
				randTest.particles++;
			} //Uses an entropy driven Metropolis prediction alogrithm to nudge particles towards greater entropy

		}
		/*for(EntropyPanel p : panels) {
			p.repaint();
		}*/
		EntropyAtAPoint.setText("Current Entropy: " + S + " J/K");
		isStepping = false;
	}
	
	
	
	public double Logfactorial(int n) {
		double returner = 0;
		
		for(int i = 1; i <= n; i++) {
			returner += Math.log(i);
		}
		return returner;
	}
	
	public double setOmega(ArrayList<EntropyPanel> panels) {
		double returner = Logfactorial(numParticles);
		for(EntropyPanel p : panels) {
			returner -= Logfactorial(p.particles);  //Log Omega = LognumParticles - the sum of logfactorial particles in every microstate
			 //max is 20 factorial
		}
		return returner;
	}
	
	public double setS(double Logomega) {
		return k * Logomega;
	}
	
	
	
	public ArrayList<EntropyPanel> getPanels(){
		int particles = numParticles;
		int particlesPerBox = numParticles / (numBoxesToStartWithParticles); //add a slider for this between 1 and numParticles
		ArrayList<EntropyPanel> p = new ArrayList<EntropyPanel>(1000);
		int boxnum = 0;
		for(int y = 1; y <= numBoxes; y++) {
		for(int i = 1; i <= numBoxes; i++) {
			
			EntropyPanel box = new EntropyPanel();
			if(particles <= 0)
				particlesPerBox = 0;
			box.setBounds(i * 50 + 600, y * 50 + 25, 50, 50);
			box.particles = particlesPerBox;
			box.BoxNum = boxnum;
			boxnum ++;
			p.add(box);
			particles -= particlesPerBox;
		}
		
		}
		return p;
	}
	
	public void addPanels() {
		for(EntropyPanel p : panels) {
			frame.add(p);
		}
