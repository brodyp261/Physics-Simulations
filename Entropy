class EntropyPanel extends JPanel{
	public int particles;
	public int BoxNum; //this tells which box number it is. So when I move a particle outside of boxnum 0 i can move it to either box num 1 of noxnum 10 (diagonal from the corner)
	private Random hi;
	public EntropyPanel() {
		hi = new Random();
		this.setBackground(Color.DARK_GRAY);
		//this.setBorder(BorderFactory.createLineBorder(Color.WHITE));
	}
	
	@Override
	public void paintComponent(Graphics g) {
		super.paintComponent(g);
		
		Graphics2D g2d = (Graphics2D)g;
		for(int p = particles; p > 0; p--) {
			int x = hi.nextInt(50);
			int y = hi.nextInt(50);
			g2d.setColor(Color.RED);
			g2d.fillOval(x, y, 3, 3);
		}
	}
