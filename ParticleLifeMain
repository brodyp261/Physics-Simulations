		}
		if(e.getSource() == WtoWb) {
			if((int)(WtoW * 10) == 6 ) {
				WtoW = -0.6;
			}
			else {
				WtoW += 0.2;
			}
			forces[4][4] = WtoW;
			WtoWb.setBackground(getColor(WtoW));
		}
	}
	
	public Color getColor(double thing) {
		if(thing >= 0.59) {
			return Color.red;
		}
		if(thing >= 0.39) {
			return Color.pink;
		}
		if(thing >= 0.19) {
			return Color.yellow;
		}
		if(thing >= -0.19) {
			return Color.WHITE;
		}
		if(thing >= -0.39) {
			return Color.cyan;
		}
		if(thing >= -0.59) {
			return Color.blue;
		}
		if(thing >= -1)
			return Color.gray;
		return Color.green;
	}
	
	/*Rules:
	 * if red near blue -> repel by 1
	 * if red near green -> attract by 2
	 * if red near red -> attract by 1
	 * if green near green -> repel by 1
	 * if green near blue -> attract by 1
	 * if blue near blue -> attract by 1
	 */
	
	public void step() {
		isStepping = true;
		for(Particle p : points) {
			p.dx2 = 0;
			p.dy2 = 0;
				for(Particle po : points) {
					if(p != po) {
						double deltax = (po.x - p.x);
						double deltay = (po.y - p.y);
					double distance2 = deltax * deltax + deltay * deltay;
					
					int potype = po.type;
					int ptype = p.type;
					if(distance2 > 0 && distance2 < 3600){
						double distance = Math.sqrt(distance2);
						
						double multfx = (deltax / distance);
						double multy = (deltay / distance);
					//if(po.x != p.x && po.y != p.y && Math.abs(po.x - p.x) < 10 && Math.abs(po.y - p.y) < 10) {
						if(distance < 30) { //if the distance between particles is small, add a repulsion force
							p.dx2 -= ((30- distance) / 30.0) * multfx * 2.0;
							p.dy2 -= ((30 - distance) / 30.0) * multy * 2.0;
						}
						
						p.dx2 += forces[ptype][potype] * multfx;
						p.dy2 += forces[ptype][potype] * multy;
					}
					
					}
						}
				p.dx = (p.dx + p.dx2) * .25 + 0.01; //add up all forces plus friction and a natural moving force so they dont stand still
				p.dy = (p.dy + p.dy2) * .25 + 0.01;
				p.x += p.dx;
				p.y += p.dy;
				if(p.x < 310) {
					p.x = 310;
					p.dx = -p.dx;
					p.dx2 = 0;
				}
				else if(p.x > 1490) {
					p.x = 1490;
					p.dx = -p.dx;
					p.dx2 = 0;
				}
				if(p.y < 105) {
					p.y = 105;
					p.dy = -p.dy;
					p.dy2 = 0;
				}
				else if(p.y > 889) {
					p.y = 889;
					p.dy = -p.dy;
					p.dy2 = 0;
				}

				
			}
		screen.repaint();
		isStepping = false;
		}
	

	
	
