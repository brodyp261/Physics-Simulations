	public void spawnDots() {
		points.clear();
		Random hi = new Random();
		int c = hi.nextInt(5);
		for(int x = 300; x <= 1500; x+= 11 ) {
			for(int y = 0; y <= 900; y += 11) {
				points.add(new Particle(x,y,c));
				c = hi.nextInt(5);
			}
		}
		screen.repaint();
	}
