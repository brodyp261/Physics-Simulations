		theta2 = 0;
		dtheta1 = 0;
		dtheta2 = 0;
		this.setBounds(0, 0, 1600, 1000);
		this.setBackground(Color.BLACK);
	}
	
	@Override
	public void paintComponent(Graphics g) {
		super.paintComponent(g);
		Graphics2D g2d = (Graphics2D)g;
		
		x1 = Math.sin(theta1) * l1;
		y1 = Math.cos(theta1) * l1;
		x2 = Math.sin(theta2) * l2 +x1;
		y2 = Math.cos(theta2) * l2 + y1;
		
		g2d.setColor(Color.WHITE);
		g2d.setStroke(new BasicStroke(2));
		g2d.drawLine(600, 350, (int)Math.round(x1 + 600), (int)Math.round(y1 + 350));
		g2d.setColor(Color.RED);
		g2d.fillOval((int)Math.round(x1 + 595),(int)Math.round(y1 + 345), (int)m1 * 10, (int)m1 * 10);
