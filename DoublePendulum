	public double thetaequ(double dtheta) {
		return dtheta;
	}
	
	public double dtheta1equ(double theta1, double theta2, double dtheta1, double dtheta2) {
		double deltatheta = theta1 - 2 * theta2;
		double m1 = painty.m1;
		double m2 = painty.m2;
		double l1 = painty.l1;
		double l2 = painty.l2;
		return (-1 * (2 * m1 + m2) * g * Math.sin(theta1) - m2 * g * Math.sin(deltatheta) - 2 * Math.sin(theta1 - theta2) * m2 * (dtheta2 * dtheta2 * l2 + dtheta1 * dtheta1 * l1 * Math.cos(theta1 - theta2))) / ((2 * m1 + m2 - m2 * Math.cos(2 * theta1 - 2 * theta2)) * l1);
	}
	
	public double dtheta2equ(double theta1, double theta2, double dtheta1, double dtheta2) {
		double deltatheta = theta1 - theta2;
		double m1 = painty.m1;
		double m2 = painty.m2;
		double l1 = painty.l1;
		double l2 = painty.l2;
		return (2 * Math.sin(theta1 - theta2) * (dtheta1 * dtheta1 * l1 * (m1 + m2) + g * (m1 + m2) * Math.cos(theta1) + dtheta2 * dtheta2 * l2 * m2 * Math.cos(theta1 - theta2))) / ((2 * m1 + m2 - m2 * Math.cos(2 * theta1 - 2 * theta2)) * l2);
	}
	
	public void stepRK4() {
		double stepSize = 0.000004; //probably change it to a lower step size for more accuracy
		double theta1 = painty.theta1;
		double theta2 = painty.theta2;
		double dtheta1 = painty.dtheta1;
		double dtheta2 = painty.dtheta2;
		
		
		//rk4
		double k1theta1 = thetaequ(dtheta1);  //derivative of F(theta) is just angular velocity
		double k1dtheta1 = dtheta1equ(theta1, theta2, dtheta1, dtheta2);
		double k1theta2 = thetaequ(dtheta2);
		double k1dtheta2 = dtheta2equ(theta1, theta2, dtheta1, dtheta2);
		
		double k2theta1 = thetaequ(dtheta1 + stepSize * .5 * k1theta1);
		double k2dtheta1 = dtheta1equ(theta1 + stepSize / 2 * k1theta1, theta2 + stepSize / 2 * k1theta2, dtheta1 + stepSize / 2 * k1dtheta1, dtheta2 + stepSize / 2 * k1dtheta2);
		double k2theta2 = thetaequ(dtheta2 + stepSize / 2 * k1theta2);
		double k2dtheta2 = dtheta2equ(theta1 + stepSize / 2 * k1theta1, theta2 + stepSize / 2 * k1theta2, dtheta1 + stepSize / 2 * k1dtheta1, dtheta2 + stepSize / 2 * k1dtheta2);
		
		double k3theta1 = thetaequ(dtheta1 + stepSize / 2 * k2theta1);
		double k3dtheta1 = dtheta1equ(theta1 + stepSize / 2 * k2theta1, theta2 + stepSize / 2 * k2theta2, dtheta1 + stepSize / 2 * k2dtheta1, dtheta2 + stepSize / 2 * k2dtheta2);
		double k3theta2 = thetaequ(dtheta2 + stepSize / 2 * k2theta2);
		double k3dtheta2 = dtheta1equ(theta1 + stepSize / 2 * k2theta1, theta2 + stepSize / 2 * k2theta2, dtheta1 + stepSize / 2 * k2dtheta1, dtheta2 + stepSize / 2 * k2dtheta2);
		
		double k4theta1 = thetaequ(dtheta1 + stepSize * k3theta1);
		double k4dtheta1 = dtheta1equ(theta1 + stepSize * k3theta1, theta2 + stepSize * k3theta2, dtheta1 + stepSize * k3dtheta1, dtheta2 + stepSize * k3dtheta2);
		double k4theta2 = thetaequ(dtheta2 + stepSize * k3theta2);
		double k4dtheta2 = dtheta1equ(theta1 + stepSize * k3theta1, theta2 + stepSize * k3theta2, dtheta1 + stepSize * k3dtheta1, dtheta2 + stepSize * k3dtheta2);
		
		theta1 = theta1 + (stepSize / 6) * (k1theta1 + 2 * k2theta1 + 2 * k3theta1 + k4theta1);
		dtheta1 = dtheta1 + (stepSize / 6) * (k1dtheta1 + 2 * k2dtheta1 + 2 * k3dtheta1 + k4dtheta1);
		theta2 = theta2 + (stepSize / 6) * (k1theta2 + 2 * k2theta2 + 2 * k3theta2 + k4theta2);
		dtheta2 = dtheta2 + (stepSize / 6) * (k1dtheta2 + 2 * k2dtheta2 + 2 * k3dtheta2 + k4dtheta2);
		
		//reassigning to painty
		painty.theta1 = theta1;
		painty.theta2 = theta2;
		painty.dtheta1 = dtheta1;
		painty.dtheta2 = dtheta2;
		
		
	}
	
